# Ignisyl Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Environment Selection
# ==========================================
# Options: development, testing
ENVIRONMENT=development

# ==========================================
# Database
# ==========================================
# SQLite only. The database file is created automatically under data/
# on first startup - no database variables are needed.
DB_TYPE=sqlite

# ==========================================
# Application Settings
# ==========================================
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# Security Settings
# ==========================================
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
