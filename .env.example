# Ignisyl Environment Configuration
# Copy this file to .env and update with your values

# ==========================================
# Environment Selection
# ==========================================
# Options: development, testing, production, docker_postgres, docker_mysql
ENVIRONMENT=development

# ==========================================
# Database Configuration
# ==========================================
# For PostgreSQL or MySQL production environments

# Database Type (postgresql, mysql, sqlite)
DB_TYPE=postgresql

# Database Host
DB_HOST=localhost

# Database Port (5432 for PostgreSQL, 3306 for MySQL)
DB_PORT=5432

# Database Name
DB_NAME=ignisyl

# Database User
DB_USER=ignisyl_user

# Database Password
DB_PASSWORD=secure_password_here

# ==========================================
# Application Settings
# ==========================================
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# Security Settings
# ==========================================
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# Example Configurations
# ==========================================

# SQLite (Development)
# ENVIRONMENT=development
# No additional DB_ variables needed

# PostgreSQL (Production)
# ENVIRONMENT=production
# DB_TYPE=postgresql
# DB_HOST=your-postgres-host.example.com
# DB_PORT=5432
# DB_NAME=ignisyl
# DB_USER=ignisyl_user
# DB_PASSWORD=your-secure-password

# MySQL (Production)
# ENVIRONMENT=production_mysql
# DB_TYPE=mysql
# DB_HOST=your-mysql-host.example.com
# DB_PORT=3306
# DB_NAME=ignisyl
# DB_USER=ignisyl_user
# DB_PASSWORD=your-secure-password

# PostgreSQL (Docker)
# ENVIRONMENT=docker_postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=ignisyl
# DB_USER=ignisyl_user
# DB_PASSWORD=ignisyl_password

# MySQL (Docker)
# ENVIRONMENT=docker_mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=ignisyl
# DB_USER=ignisyl_user
# DB_PASSWORD=ignisyl_password
